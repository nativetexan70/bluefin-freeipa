[Unit]
Description=Install Homebrew for all users (first boot only)
# Homebrew's installer needs to fetch itself and every formula it bootstraps
# with over the network; there is no useful offline fallback.
After=network-online.target
Wants=network-online.target
# Skips (not fails) on every later boot once the install has completed,
# so this unit is safe to leave enabled permanently rather than needing to
# disable itself after running.
ConditionPathExists=!/var/home/linuxbrew/.linuxbrew/bin/brew

[Service]
Type=oneshot
ExecStart=/usr/libexec/homebrew-install.sh
# No RemainAfterExit: the ConditionPathExists check above is what makes
# this idempotent across boots, not systemd's active-state tracking. A
# failed attempt (e.g. no network on first boot) is expected to just be
# retried on the next boot, which a plain oneshot already does.

[Install]
WantedBy=multi-user.target
