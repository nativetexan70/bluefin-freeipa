[Unit]
Description=Install Homebrew for all users, and keep its group/permissions correct
# Homebrew's installer needs to fetch itself and every formula it bootstraps
# with over the network; there is no useful offline fallback. The actual
# install only ever runs once (homebrew-install.sh checks for an existing
# `brew` binary itself), but this unit intentionally has no
# ConditionPathExists gate on that: it also re-normalizes the prefix's
# group ownership/permissions every boot, which must keep running even
# after Homebrew is installed - see homebrew-install.sh for why.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/homebrew-install.sh
# No RemainAfterExit: this unit is meant to actually run and do its
# (idempotent) work on every boot, not just once. A failed attempt (e.g.
# no network on first boot, before Homebrew is installed at all) is
# expected to just be retried on the next boot, which a plain oneshot
# already does.

[Install]
WantedBy=multi-user.target
